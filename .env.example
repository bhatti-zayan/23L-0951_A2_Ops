# Copy to .env and fill in real values. .env is git-ignored and never baked into the image.
# local = model runs inside this app, remote = forward images to MODEL_API_URL
MODEL_MODE=local
# empty = use the threshold stored in models/champion_meta.json
DECISION_THRESHOLD=
MAX_UPLOAD_MB=5
SECRET_KEY=change-me
# protects /api/predict (sent as X-API-Key header)
API_KEY=change-me
# only used when MODEL_MODE=remote
MODEL_API_URL=
WEB_PORT=8000
# Postgres (use letters/digits only in the password)
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=visionguard
