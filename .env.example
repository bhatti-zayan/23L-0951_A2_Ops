# Copy to .env and fill in real values. .env is git-ignored.
# ---- Flask app ----
MODEL_MODE=local                          # local = model in this app, remote = call MODEL_API_URL
MODEL_PATH=models/champion.keras
MODEL_META_PATH=models/champion_meta.json
DECISION_THRESHOLD=                       # empty = use threshold from champion_meta.json
MAX_UPLOAD_MB=5
SECRET_KEY=change-me
API_KEY=change-me                         # protects /api/predict
MODEL_API_URL=                            # only for MODEL_MODE=remote
DATABASE_URL=sqlite:///visionguard_dev.db
# ---- Postgres (docker compose) ----
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=visionguard
# ---- DagsHub (MLflow / DVC) ----
DAGSHUB_USERNAME=your_dagshub_username
DAGSHUB_TOKEN=your_dagshub_token
MLFLOW_TRACKING_URI=https://dagshub.com/your_dagshub_username/23L-0951_A2_Ops.mlflow
